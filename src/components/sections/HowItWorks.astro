---
import Character from '../Character.astro';
import { getCopy } from '../../lib/copy';
const copy = await getCopy('how');
type Kind = 'human' | 'agent' | 'troupe';
// One scene per step, in step order. The troupe triangle sits somewhere different in each.
const SCENES: { pos: 'left' | 'right' | 'centre' | 'top'; kinds: Kind[] }[] = [
  { pos: 'left', kinds: ['troupe', 'human', 'agent'] },
  { pos: 'right', kinds: ['agent', 'agent', 'troupe'] },
  { pos: 'centre', kinds: ['human', 'troupe'] },
  { pos: 'top', kinds: ['troupe'] },
];
const n = copy.steps.length;
---
<section id="how-it-works" class="how" aria-labelledby="how-title">
  <div class="curtain" aria-hidden="true"></div>
  <div class="wrap inner">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="how-title">{copy.title}</h2>
    <p class="intro">{copy.intro}</p>
    <div class="carousel" role="group" aria-roledescription="carousel" aria-label="The four steps of a run" data-carousel>
      <div class="controls" hidden data-controls>
        <div class="tabs" role="tablist" aria-label="Steps">
          {copy.steps.map((s, i) => (
            <button class="tab eyebrow" type="button" role="tab" id={`step-tab-${i}`} aria-controls={`step-panel-${i}`}
                    aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={i}>{s.label}</button>
          ))}
        </div>
        <div class="dial" aria-hidden="false">
          <svg class="ring" viewBox="0 0 56 56" aria-hidden="true" focusable="false">
            <circle cx="28" cy="28" r="20" fill="none" stroke="var(--soft)" stroke-width="2" />
            <path d="M28 8 l-5 -4 M28 8 l-5 4" fill="none" stroke="var(--soft)" stroke-width="2" stroke-linecap="round" transform="rotate(45 28 28)" />
          </svg>
          {copy.steps.map((s, i) => (
            <button class="dot" type="button" tabindex="-1" data-dot={i} data-pos={i}
                    aria-label={`Go to step ${i + 1} of ${n}: ${s.label}`} aria-current={i === 0 ? 'true' : undefined}></button>
          ))}
        </div>
      </div>
      <div class="slides" aria-live="off" data-slides>
        {copy.steps.map((s, i) => (
          <div class={`step slide${i === 0 ? ' is-current' : ''}`} role="tabpanel" id={`step-panel-${i}`}
               aria-labelledby={`step-tab-${i}`} aria-roledescription="slide" data-slide={i}>
            <div class="words">
              <p class="eyebrow">{s.label}</p>
              <h3>{s.title}</h3>
              <p class="body">{s.body}</p>
            </div>
            <div class="scene" data-troupe-pos={SCENES[i].pos} aria-hidden="true">
              {SCENES[i].kinds.map((k) => <Character kind={k} size={44} />)}
            </div>
          </div>
        ))}
      </div>
    </div>
    <p class="loop">{copy.loop}</p>
  </div>
</section>
<script>
  import { createSeasonCarousel } from '../../scripts/season-carousel';

  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const live = root.querySelector<HTMLElement>('[data-slides]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const total = slides.length;

    const show = (index: number) => {
      slides.forEach((s, i) => {
        s.classList.toggle('is-current', i === index);
        s.setAttribute('aria-label', `${i + 1} of ${total}: ${tabs[i].textContent?.trim()}`);
      });
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === index));
        t.tabIndex = i === index ? 0 : -1;
      });
      dots.forEach((d, i) => (i === index ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      root.dataset.index = String(index);
    };

    const carousel = createSeasonCarousel({
      count: total,
      startPaused: reduce.matches,
      onChange: show,
      onState: (s) => {
        live.setAttribute('aria-live', s.rotating ? 'off' : 'polite');
      },
    });

    root.dataset.enhanced = '';
    root.querySelectorAll<HTMLElement>('[hidden]').forEach((e) => e.removeAttribute('hidden'));
    show(0);

    // WCAG 2.2.2: choosing a step shows it and stops the auto-advance for the rest of the page view (as in the
    // APG carousel pattern, rotation stops once the user activates a control). There is no Play button.
    tabs.forEach((t, i) => t.addEventListener('click', () => carousel.activate(i)));
    dots.forEach((d, i) => d.addEventListener('click', () => carousel.activate(i)));

    root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const cur = carousel.state.index;
      const to = k === 'ArrowRight' ? cur + 1 : k === 'ArrowLeft' ? cur - 1 : k === 'Home' ? 0 : k === 'End' ? total - 1 : null;
      if (to === null) return;
      e.preventDefault();
      carousel.activate(((to % total) + total) % total);
      tabs[carousel.state.index].focus();
    });

    root.addEventListener('pointerenter', () => carousel.setHovered(true));
    root.addEventListener('pointerleave', () => carousel.setHovered(false));
    root.addEventListener('focusin', (e) => {
      if ((e.target as Element).matches(':focus-visible')) carousel.setFocused(true);
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains((e as FocusEvent).relatedTarget as Node | null)) carousel.setFocused(false);
    });

    let onScreen = true;
    const sync = () => carousel.setVisible(onScreen && !document.hidden);
    new IntersectionObserver(([entry]) => { onScreen = entry.isIntersecting; sync(); }).observe(root);
    document.addEventListener('visibilitychange', sync);
    reduce.addEventListener('change', () => { if (reduce.matches) carousel.stop(); });
  }
</script>
<style>
  .how { padding-bottom: 40px; background: var(--surface); }
  .curtain { height: 16px; background: repeating-linear-gradient(90deg, var(--tomato) 0 14px, var(--tomato-shadow) 14px 18px); border-bottom: 3px solid var(--sunflower); }
  .inner { padding-top: 28px; }
  h2 { font-size: clamp(24px, 4vw, 34px); margin: 6px 0; }
  .intro { color: var(--muted); }
  .carousel { margin-top: 18px; }
  .controls[hidden] { display: none; }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 6px; margin-bottom: 12px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 4px; margin-right: auto; }
  .tab { appearance: none; background: none; border: 0; border-bottom: 2px solid transparent; cursor: pointer; padding: 8px 10px; min-height: 24px; color: var(--muted); }
  .tab[aria-selected='true'] { color: var(--tomato-text); border-bottom-color: var(--tomato-text); }
  .tab:hover { color: var(--ink); }
  .dial { position: relative; width: 56px; height: 56px; margin-right: 6px; }
  .ring { position: absolute; inset: 0; }
  .dot { position: absolute; width: 24px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; margin: -12px 0 0 -12px; }
  .dot::after { content: ''; position: absolute; inset: 7px; border-radius: 50%; background: var(--soft); }
  .dot[aria-current='true']::after { background: var(--tomato); }
  .dot[data-pos='0'] { left: 28px; top: 8px; }
  .dot[data-pos='1'] { left: 48px; top: 28px; }
  .dot[data-pos='2'] { left: 28px; top: 48px; }
  .dot[data-pos='3'] { left: 8px; top: 28px; }
  .slides { display: grid; gap: 16px; }
  .slide { background: var(--bg); border: 1px solid var(--line); border-radius: 16px; padding: 24px; display: grid; grid-template-columns: 1fr auto; gap: 16px 24px; align-items: center; }
  [data-enhanced] .slide:not(.is-current) { display: none; }
  [data-enhanced] .slide.is-current { animation: slide-in 250ms ease-out; }
  @keyframes slide-in { from { opacity: 0; transform: translateX(12px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { [data-enhanced] .slide.is-current { animation: none; } }
  .slide h3 { font-size: 22px; margin: 4px 0; }
  .slide .body { margin: 0; color: var(--muted); max-width: 46ch; }
  .scene { display: flex; align-items: flex-end; gap: 12px; width: 220px; min-height: 120px; padding-bottom: 28px; }
  .scene[data-troupe-pos='left'] { justify-content: flex-start; }
  .scene[data-troupe-pos='right'] { justify-content: flex-end; }
  .scene[data-troupe-pos='centre'] { justify-content: center; }
  .scene[data-troupe-pos='top'] { justify-content: center; align-items: flex-start; }
  @media (max-width: 599px) {
    .slide { grid-template-columns: 1fr; }
    .scene { width: 100%; justify-content: center; }
    .scene[data-troupe-pos='left'] { justify-content: flex-start; }
    .scene[data-troupe-pos='right'] { justify-content: flex-end; }
  }
  .loop { text-align: center; font-family: var(--font-mono); font-size: 13px; color: var(--teal-text); margin-top: 14px; }
</style>
