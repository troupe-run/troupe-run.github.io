---
import Character from '../Character.astro';
import { getCopy } from '../../lib/copy';
const copy = await getCopy('how');
---
<section id="how-it-works" class="how" aria-labelledby="how-title">
  <div class="curtain" aria-hidden="true"></div>
  <div class="wrap inner">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="how-title">{copy.title}</h2>
    <p class="intro">{copy.intro}</p>
    <div class="diagram">
      <ol class="steps">
        {copy.steps.map((s) => (
          <li class="step"><p class="eyebrow">{s.label}</p><h3>{s.title}</h3><p>{s.body}</p></li>
        ))}
      </ol>
      <div class="centre"><Character kind="troupe" size={56} /></div>
    </div>
    <p class="loop">{copy.loop}</p>
  </div>
</section>
<style>
  .how { padding-bottom: 40px; background: var(--surface); }
  .curtain { height: 16px; background: repeating-linear-gradient(90deg, var(--tomato) 0 14px, var(--tomato-shadow) 14px 18px); border-bottom: 3px solid var(--sunflower); }
  .inner { padding-top: 28px; }
  h2 { font-size: clamp(24px, 4vw, 34px); margin: 6px 0; }
  .intro { color: var(--muted); }
  .diagram { position: relative; margin-top: 18px; }
  .centre { display: none; }
  .steps { list-style: none; padding: 0 0 0 20px; margin: 0; border-left: 2px solid var(--line); display: grid; gap: 20px; }
  .step h3 { font-size: 18px; margin: 4px 0; }
  .step p:last-child { margin: 0; color: var(--muted); font-size: 15px; }
  @media (min-width: 720px) {
    .steps {
      position: relative; border-left: 0; padding: 0; gap: 0;
      grid-template-columns: 1fr minmax(0, 22ch) 1fr; grid-template-rows: auto auto auto;
      justify-items: center; text-align: center; row-gap: 56px;
    }
    .steps::before {
      content: ''; position: absolute; inset: 40px 12%; border: 3px dashed color-mix(in srgb, var(--teal) 45%, transparent);
      border-radius: 50%; pointer-events: none;
    }
    .step { position: relative; max-width: 22ch; background: var(--surface); padding: 6px 8px; }
    .step:nth-child(1) { grid-column: 2; grid-row: 1; }
    .step:nth-child(2) { grid-column: 3; grid-row: 2; }
    .step:nth-child(3) { grid-column: 2; grid-row: 3; }
    .step:nth-child(4) { grid-column: 1; grid-row: 2; }
    .centre { display: block; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -60%); }
  }
  .loop { text-align: center; font-family: var(--font-mono); font-size: 13px; color: var(--teal-text); margin-top: 14px; }
</style>
