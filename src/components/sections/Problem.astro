---
import ProblemQueue from '../ProblemQueue.astro';
import { getCopy } from '../../lib/copy';
const copy = await getCopy('problem');
---
<section id="problem" class="problem" aria-labelledby="problem-title">
  <div class="wrap">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="problem-title">{copy.title}</h2>
    <div class="queue"><ProblemQueue caption={copy.queueCaption} /></div>
    <ul class="problem-list">
        {copy.items.map((c) => (
          <li><span class="dot" aria-hidden="true"></span><div><strong>{c.title}</strong><span class="body">{c.body}</span></div></li>
        ))}
    </ul>
  </div>
</section>
<style>
  .problem { padding: 40px 0; }
  h2 { font-size: clamp(24px, 4vw, 34px); }
  .queue { margin-top: 20px; }
  .problem-list { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  @media (max-width: 1023px) { .problem-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 599px) { .problem-list { grid-template-columns: 1fr; } }
  .problem-list li { display: flex; gap: 12px; align-items: flex-start; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--tomato); margin-top: 9px; }
  strong { display: block; font-family: var(--font-display); font-size: 17px; margin-bottom: 2px; }
  .body { color: var(--muted); }
</style>
