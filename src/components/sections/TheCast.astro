---
import { getCopy } from '../../lib/copy';
const copy = await getCopy('cast');
---
<section id="the-cast" class="cast" aria-labelledby="cast-title">
  <div class="wrap grid">
    <div class="text">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="cast-title">{copy.title}</h2>
      <p class="body">{copy.body}</p>
    </div>
    <div class="list">
      <ul class="rows">
        {copy.rows.map((r) => (
          <li class="row" data-kind={r.kind}>
            <span class={`shape shape--${r.kind}`} data-kind={r.kind} aria-hidden="true"></span>
            <span class="role">{r.role}</span>
            <span class="leader" aria-hidden="true"></span>
            <span class="holder">{r.holder}</span>
          </li>
        ))}
      </ul>
      <p class="gate eyebrow">{copy.gate}</p>
      <p class="note">{copy.note}</p>
    </div>
  </div>
</section>
<style>
  .cast { background: var(--ink); color: var(--bg); padding: 48px 0; }
  .grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 32px; align-items: center; }
  @media (max-width: 719px) { .grid { grid-template-columns: 1fr; } }
  .list { min-width: 0; background: color-mix(in srgb, var(--bg) 4%, var(--ink)); border-radius: 12px; padding: 20px; }
  .eyebrow { color: var(--inverse-accent); }
  h2 { font-size: clamp(24px, 4vw, 34px); margin: 6px 0 12px; color: var(--bg); }
  .body { margin: 0; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: flex; align-items: baseline; gap: 10px; padding: 8px 0; }
  .shape { flex: none; width: 18px; height: 18px; align-self: center; }
  .shape--human { border-radius: 50%; background: var(--lilac); }
  .shape--agent { border-radius: 5px; background: var(--teal); }
  .role { font-family: var(--font-display); font-size: 18px; color: var(--bg); }
  .leader { flex: 1; min-width: 12px; border-bottom: 2px dotted color-mix(in srgb, var(--bg) 40%, var(--ink)); }
  .holder { color: color-mix(in srgb, var(--bg) 72%, var(--ink)); }
  .gate { margin: 14px 0 0; padding-top: 14px; border-top: 1px solid color-mix(in srgb, var(--bg) 20%, var(--ink)); }
  .note { margin: 6px 0 0; font-size: 13px; color: color-mix(in srgb, var(--bg) 70%, var(--ink)); }
</style>
