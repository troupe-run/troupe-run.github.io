---
// At phone width the docs header has no room for the site links beside the menu button, so they live here,
// at the foot of the mobile menu. (The default footer holds social icons and the theme picker; this site has
// neither.)
import { getCopy } from '../../lib/copy';
const copy = await getCopy('header');
---
<nav class="mobile-site-nav" aria-label="Site">
  <ul>{copy.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
</nav>
<style>
  .mobile-site-nav { border-top: 1px solid var(--sl-color-gray-6); padding-block: 1rem; }
  ul { display: flex; flex-wrap: wrap; gap: 8px 20px; list-style: none; margin: 0; padding: 0; }
  a { color: var(--ink); text-decoration: none; font-size: 16px; }
  a:hover { color: var(--tomato-text); text-decoration: underline; }
</style>
