import Search from '@astrojs/starlight/components/Search.astro';
import SiteHeader from '../sections/Header.astro';
import { siteSection } from '../../lib/site-section';
---
<SiteHeader section={siteSection(Astro.locals.starlightRoute.id)} embedded><Search /></SiteHeader>
